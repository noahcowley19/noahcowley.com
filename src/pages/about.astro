---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
//check if photo exists
const hasPhoto = fs.existsSync(new URL('../../public/images/about.jpeg', 
import.meta.url).pathname);
---
<Base
  title="About"
  description="Who writes this, what it is, and what it is not."
>
  <h1 class="page-title">About</h1>
  {/* Drop the photo in at public/images/about.jpg and it appears on the
      next build; while the file is absent the page simply has no photo. */}
  {
    hasPhoto && (
      <img
        class="about-photo"
        src="/images/about.jpeg"
        alt="Noah Cowley at Machu Picchu, wearing a woven poncho, with Huayna Picchu behind"
        width="1210"
        height="1512"
        loading="lazy"
      />
    )
  }

  <div class="prose">
    <p>
      <strong>I'm Noah Cowley. I'm a student at Jesuit Dallas, developer, long-time finance enthusiast and business columnist in the (<a href="https://jesuitroundup.org">Jesuit Roundup</a>
      I started this project to publicly document investment theses and subsequent price changes, building something of a track record.
    </p>

    <p>
      This site publishes independent equity research: one thesis per name,
      each with a stance, a price, a horizon, and a conviction level fixed
      at publication. Nothing is edited after the fact: when a thesis
      stops holding, it's recorded, not rewritten. The
      <a href="/record">record page</a> keeps score on every thesis, manually updated frequently. 
    </p>

    <h2>Disclaimer</h2>

    <p>
      NOTHING on this site is investment advice, an offer, or a
      solicitation. I may hold positions in any given security I write about, 
      and I may change or exit those positions without updating what's published
      here. This is solely a fun side project; don't sue me.
    </p>
  </div>
</Base>
